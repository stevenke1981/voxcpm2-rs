{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "edit": "allow",
    "bash": {
      "cargo fmt*": "allow",
      "cargo clippy*": "allow",
      "cargo test*": "allow",
      "cargo run*": "allow",
      "python scripts/inspect_safetensors.py*": "allow",
      "python tests/golden/check_wav.py*": "allow",
      "powershell -File harness/run_all.ps1*": "allow",
      "./harness/run_all.ps1*": "allow",
      "rm*": "deny",
      "git rm*": "deny",
      "Remove-Item*": "deny"
    }
  }
}
